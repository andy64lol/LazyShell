#!/bin/bash

DEFAULT_PORT=8000

get_ip() {
    hostname -I | awk '{print $1}'
}

kill_port() {
    PORT=$1
    PID=$(lsof -ti:$PORT)

    if [ -n "$PID" ]; then
        kill -9 $PID
        echo "✓ Killed process on port $PORT"
    else
        echo "• Nothing running on port $PORT"
    fi
}

start_server() {
    PORT=$1
    IP=$(get_ip)

    echo "Python HTTP Server"
    echo "Local:  http://localhost:$PORT"
    echo "Network: http://$IP:$PORT"
    echo ""

    python3 -m http.server $PORT
}

# flags
FORCE=false
OPEN=false
KILL=false
PORT=""

for arg in "$@"; do
    case $arg in
        --force) FORCE=true ;;
        --kill) KILL=true ;;
        --open) OPEN=true ;;
        *) PORT=$arg ;;
    esac
done

PORT=${PORT:-$DEFAULT_PORT}

if $KILL; then
    kill_port $PORT
    exit
fi

if $FORCE; then
    kill_port $PORT
fi

if $OPEN; then
    (sleep 1 && xdg-open "http://localhost:$PORT" >/dev/null 2>&1) &
fi

start_server $PORT