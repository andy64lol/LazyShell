#!/bin/bash
# lazyshell.help — Display LazyShell command reference and usage info

cat <<'EOF'
LazyShell — small collection of helper shell scripts
-----------------------------------------------------

LazyShell is a lightweight set of personal shell utilities for common developer tasks:
- Installing small CLI scripts system-wide
- Quick Git helpers
- Repo info
- Python helpers
- Shortcut manager

Quick Install
-------------
Install all scripts to PATH:
    bash ./activation

Manual install example:
    sudo cp <script> /usr/local/bin/
    sudo chmod +x /usr/local/bin/<script>

Included Scripts
----------------
activation  - Copy scripts from scripts/ directory to /usr/local/bin, make executable, skip certain files. Supports -h|--help, auto-runs gitupdate if available.

appstore   - Search for packages across all available package managers:
                appstore <package_name>  # search apt, dnf, yum, pacman, zypper

del         - Flexible removal helper:
                del <name>      # apt remove or rm -i
                del -p <name>   # purge apt package or rm -f
                del -dir <dir>  # remove directory with confirmation
                del -pdir <dir> # purge directory after explicit confirmation

exec        - File permission manager:
                exec <file...>           # make file(s) executable
                exec --all               # make all files executable
                exec --remove <file...>  # remove executable from file(s)
                exec --remove-all        # remove executable from all files

gitauto     - Walk directories, find Git repos, stage & commit all changes, push to origin.

gitid       - Interactive Git identity helper:
                --local         # set repo-local identity
                --view          # show saved identity & GitHub username

gitstat     - Show Git info for current directory or provided path (branch, status, recent commits, remotes, reflog).

gitupdate   - Update repository from remote:
                gitupdate                # update current repo
                gitupdate <dir>          # update specified repo
                gitupdate <url> <path> <file_path> # clone or update, check for file

inforepo    - Show repo metadata (creation info, remote URL, approximate clone date, LOC summary with cloc fallback).

py          - Python runner & bootstrapper:
                py pyver        # show Python/pip versions
                py <args...>    # runs python3 <args...>

pyinstall   - Install Python packages:
                pyinstall <name>          # system package
                pyinstall -f <package>   # pip install --break-system-packages (dangerous)

pyver       - Ensure python3/pip3 are installed, then show versions.

rmv         - Preview apt autoremove, then prompt to run.

server      - Python HTTP server with port management:
                server [port]             # start server (default port 8000)
                server --kill [port]      # kill process on port
                server --force [port]     # kill then start server
                server --open [port]      # start server and open browser

show        - Directory tree viewer:
                show [directory]          # display recursive tree with file metadata (path, size, last modified, last accessed)

st          - Shortcut manager:
                st                        # create shortcut
                st --del <name>           # delete shortcut
                st --help                 # show help
                -h                        # short help

telltime    - Display current time:
                telltime                  # show time in HH:MM:SS
                telltime --milisecs       # show time with milliseconds
                telltime --live           # live updating clock (Ctrl+C to exit)

telldate    - Display current date:
                telldate                  # show date in DD-MM-YYYY
                telldate --iso            # show date in YYYY-MM-DD
                telldate --full           # show full date (e.g., "Monday October 16 2025")
                telldate --live           # live updating date (Ctrl+C to exit)

upt         - Preview apt upgrade, then prompt to run.

dupefind    - Smart duplicate finder:
                dupefind [directory]                 # Find duplicates
                dupefind -d                          # Interactive delete
                dupefind -m ./dups                   # Move duplicates
                dupefind -s                          # Use SHA256 hash

findex      - Fuzzy file search:
                findex <pattern>                     # Fuzzy name search
                findex -c "text"                     # Content search
                findex -r "^regex$"                   # Regex search
                findex -p                            # Show preview

diskusage   - Disk usage visualizer:
                diskusage [directory]                # Tree with sizes
                diskusage -s -h                       # Sort, human readable
                diskusage -p                          # Show percentages
                diskusage -d 2                       # Depth limit

clipper     - Clipboard history manager:
                clipper                              # Show history
                clipper add "text"                   # Add to history
                clipper search "query"               # Search history
                clipper paste 3                      # Paste item #3
                clipper top                          # Paste most recent

hunt        - Process explorer:
                hunt                                 # Show top processes
                hunt -m                              # Sort by memory
                hunt -f chrome                       # Filter processes
                hunt -t                              # Tree view
                hunt -K -f chrome                    # Kill all chrome

diskcheck   - Disk monitor & cleanup:
                diskcheck                            # Show disk usage
                diskcheck -d                         # Detailed view
                diskcheck -c                         # Cleanup suggestions
                diskcheck -a -t 85                   # Alert if >85%

pingburst   - Multi-host ping tool:
                pingburst                            # Ping defaults
                pingburst host1 host2                # Multiple hosts
                pingburst -l -a server.com           # Log with alerts
                pingburst -r                          # Show report

fetch       - Batch URL downloader:
                fetch url1 url2                      # Download URLs
                fetch -f urls.txt                    # From file
                fetch -o ./dir url                   # Custom output
                fetch -c url                         # Resume download

timer       - Multi-timer CLI:
                timer                                # Show timers
                timer start 25                       # Start 25 min timer
                timer start 5 break                  # Labeled timer
                timer stop 1                         # Stop timer #1
                timer -n start 10 test              # With notification
                timer log                            # Show history

randpass    - Random password generator:
                randpass                             # 16 char password
                randpass -l 24                       # Custom length
                randpass -s                          # Include symbols
                randpass -m                          # Memorable words
                randpass -p                          # PIN code
                randpass -C                          # Copy to clipboard

Examples
--------
Create a shortcut named 'hello':
    st
    # command 'echo Hello', name 'hello'
    hello

Batch auto-commit repositories:
    gitauto /path/to/search

Show repo info for another repo:
    inforepo /path/to/project

Find and remove duplicate files:
    dupefind ./photos
    dupefind -d ./photos         # Interactive delete mode
    dupefind -m ./dups ./music   # Move duplicates to folder
    dupefind -s                  # SHA256 hash mode

Search for files with fuzzy matching:
    findex "config"
    findex -c "TODO"             # Search file contents
    findex -r "^main.*\.js$"     # Regex search
    findex -p                    # Show preview
    findex -i                    # Case insensitive

Check disk usage:
    diskusage
    diskusage -s -h              # Sort by size, human readable
    diskusage -d 2               # Limit depth to 2 levels
    diskusage -p                 # Show percentages
    diskusage /home/user         # Check specific directory

Manage clipboard history:
    clipper add "Remember this"
    clipper                      # Show history
    clipper search "text"       # Search history
    clipper paste 2             # Paste item #2
    clipper top                 # Paste most recent
    clipper clear               # Clear all history

Find and manage processes:
    hunt                         # Show top processes
    hunt -m                     # Sort by memory
    hunt -f chrome              # Filter chrome
    hunt -t                      # Tree view
    hunt -K -f chrome           # Kill all chrome

Monitor disk health:
    diskcheck                    # Quick summary
    diskcheck -d                 # Detailed view
    diskcheck -c                 # Cleanup suggestions
    diskcheck -a -t 80           # Alert if >80%
    diskcheck -c -f              # Force cleanup

Ping multiple hosts:
    pingburst 8.8.8.8 1.1.1.1
    pingburst host1 host2 host3
    pingburst -l -a server.com   # Log with alerts
    pingburst -r                 # Show report
    pingburst -c 10              # Count packets

Download multiple files:
    fetch url1.zip url2.zip
    fetch -f urls.txt            # From file
    fetch -o ./downloads url     # Custom output
    fetch -c url                 # Resume download
    fetch -q                     # Quiet mode

Use timers:
    timer start 25 focus         # 25 min focus timer
    timer start 5 break          # 5 min break
    timer                        # Show all timers
    timer stop 1                 # Stop timer #1
    timer -n start 10 test       # With notification
    timer log                    # View history
    timer clear                  # Clear all timers

Generate passwords:
    randpass                     # 16 char password
    randpass -l 32               # Custom length
    randpass -s                  # Include symbols
    randpass -m                  # Memorable words
    randpass -p                  # PIN code
    randpass -C                  # Copy to clipboard

Check network connectivity:
    netcheck                     # Basic check
    netcheck -d                  # Detailed output
    netcheck -s                  # Speed test
    netcheck --dns               # DNS lookup
    netcheck -t                  # Trace route

Backup and restore:
    backup
    backup /home/user/documents
    backup -c config             # Custom config
    backup --encrypt             # Encrypted backup
    backup --restore             # List/restore

    cloudbackup ./project
    cloudbackup --service dropbox
    cloudbackup --sync
    cloudbackup --list

    cloudrestore
    cloudrestore --date 2025-01-01
    cloudrestore --list
    cloudrestore --select

    restore
    restore 1
    restore --date 2025-01-01
    restore --preview

Check root privileges:
    rooted                       # Check if root
    rooted -v                    # Verbose output
    rooted -c "apt update"       # Run with privileges

Notes & Safety
---------------
- Many scripts use sudo for system changes.
- del refuses to remove protected system directories and prompts for destructive deletions.
- pyinstall -f can break system Python environments — requires confirmation.
- activation overwrites files in /usr/local/bin with same name.

License
-------
Apache License 2.0

EOF
