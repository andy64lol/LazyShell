#!/usr/bin/env bash

DIR="${1:-.}"

# Check if directory exists
if [[ ! -d "$DIR" ]]; then
    echo "Error: '$DIR' is not a valid directory."
    exit 1
fi

# Header
printf "%-60s %-10s %-20s %-20s\n" "PATH" "SIZE" "LAST MODIFIED" "LAST ACCESSED"
printf "%-60s %-10s %-20s %-20s\n" "----" "----" "-------------" "-------------"

# Recursive function to print tree
print_tree() {
    local PREFIX="$1"
    local DIR_PATH="$2"
    local FILE

    for FILE in "$DIR_PATH"/*; do
        [[ ! -e "$FILE" ]] && continue  # skip if no files
        local SIZE=$(stat -c "%s" "$FILE")
        local MODIFIED=$(stat -c "%y" "$FILE" | cut -d'.' -f1)
        local ACCESSED=$(stat -c "%x" "$FILE" | cut -d'.' -f1)
        printf "%-60s %-10s %-20s %-20s\n" "${PREFIX}${FILE#$DIR/}" "$SIZE" "$MODIFIED" "$ACCESSED"

        if [[ -d "$FILE" ]]; then
            print_tree "  $PREFIX" "$FILE"
        fi
    done
}

print_tree "" "$DIR"