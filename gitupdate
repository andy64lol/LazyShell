#!/bin/bash

print_usage() {
  echo "Usage:"
  echo "  gitupdate [--hard]                 # Update current directory (must be git repo)"
  echo "  gitupdate [--hard] <directory>     # Update git repo in specified directory"
}

HARD_RESET=false

# Check if first argument is --hard
if [ "$1" == "--hard" ]; then
  HARD_RESET=true
  shift
fi

# === Mode 1: No arguments (after shift) ===
if [ "$#" -eq 0 ]; then
  if [ ! -d .git ]; then
    echo " Error: Current directory is not a git repository."
    exit 1
  fi

  CURRENT_BRANCH=$(git symbolic-ref --short HEAD)
  echo " Updating current repo on branch: $CURRENT_BRANCH"

  git fetch origin || { echo " Fetch failed!"; exit 1; }

  if [ "$HARD_RESET" = true ]; then
    echo " Performing hard reset..."
    git reset --hard "origin/$CURRENT_BRANCH" || { echo " Reset failed!"; exit 1; }
  else
    echo " Performing safe merge..."
    git merge --ff-only "origin/$CURRENT_BRANCH" || { echo " Merge failed!"; exit 1; }
  fi

  echo " Update complete."
  exit 0
fi

# === Mode 2: One argument = target directory (after shift) ===
if [ "$#" -eq 1 ]; then
  TARGET_DIR="$1"

  if [ ! -d "$TARGET_DIR" ]; then
    echo " Error: '$TARGET_DIR' is not a directory."
    exit 1
  fi

  if [ ! -d "$TARGET_DIR/.git" ]; then
    echo " Error: '$TARGET_DIR' is not a git repository."
    exit 1
  fi

  cd "$TARGET_DIR" || { echo " Failed to cd into $TARGET_DIR"; exit 1; }

  CURRENT_BRANCH=$(git symbolic-ref --short HEAD)
  echo " Updating '$TARGET_DIR' on branch: $CURRENT_BRANCH"

  git fetch origin || { echo " Fetch failed!"; exit 1; }

  if [ "$HARD_RESET" = true ]; then
    echo " Performing hard reset..."
    git reset --hard "origin/$CURRENT_BRANCH" || { echo " Reset failed!"; exit 1; }
  else
    echo " Performing safe merge..."
    git merge --ff-only "origin/$CURRENT_BRANCH" || { echo " Merge failed!"; exit 1; }
  fi

  echo " Update complete."
  exit 0
fi

# === Mode 3: Full manual (URL, PATH, FILE) ===
if [ "$#" -eq 3 ]; then
  REPO_URL="$1"
  LOCAL_PATH="$2"
  FILE_PATH="$3"

  if [ ! -d "$LOCAL_PATH" ]; then
    echo " Directory does not exist. Cloning repository..."
    git clone "$REPO_URL" "$LOCAL_PATH" || { echo " Clone failed!"; exit 1; }
  else
    echo " Directory exists. Updating repository..."
    cd "$LOCAL_PATH" || { echo " Cannot enter directory $LOCAL_PATH"; exit 1; }

    if [ ! -d ".git" ]; then
      echo " Not a git repository. Re-cloning..."
      cd ..
      rm -rf "$LOCAL_PATH"
      git clone "$REPO_URL" "$LOCAL_PATH" || { echo " Clone failed!"; exit 1; }
      exit 0
    fi

    CURRENT_BRANCH=$(git symbolic-ref --short HEAD)
    echo " Updating branch: $CURRENT_BRANCH"

    git fetch origin || { echo " Fetch failed!"; exit 1; }

    if [ "$HARD_RESET" = true ]; then
      echo " Performing hard reset..."
      git reset --hard "origin/$CURRENT_BRANCH" || { echo " Reset failed!"; exit 1; }
    else
      echo " Performing safe merge..."
      git merge --ff-only "origin/$CURRENT_BRANCH" || { echo " Merge failed!"; exit 1; }
    fi
  fi

  # Check file
  if [ -f "$LOCAL_PATH/$FILE_PATH" ]; then
    echo " File '$FILE_PATH' found."
  else
    echo " Warning: File '$FILE_PATH' not found."
  fi

  echo " Git update complete."
  exit 0
fi

# === Invalid usage ===
echo " Invalid arguments."
print_usage
exit 1
